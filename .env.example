# osu! API Credentials
# Get these from https://osu.ppy.sh/home/account/edit#oauth
OSU_CLIENT_ID=your_osu_client_id_here
OSU_CLIENT_SECRET=your_osu_client_secret_here

# osu! User Information
# Your osu! username and user ID
OSU_USERNAME=your_osu_username
OSU_USER_ID=your_osu_user_id

# osu! Ruleset (optional, default: osu)
# Options: osu | taiko | fruits | mania
OSU_RULESET=osu

# osu! Songs Path (optional for classic osu!, not needed for lazer)
# Path to your local osu! Songs folder (only needed for classic osu! installations)
# For osu!lazer, use the scan-lazer command instead
OSU_SONGS_PATH=C:\Users\YourName\AppData\Local\osu!\Songs

# Spotify API Credentials
# Get these from https://developer.spotify.com/dashboard
SPOTIPY_CLIENT_ID=your_spotify_client_id_here
SPOTIPY_CLIENT_SECRET=your_spotify_client_secret_here

# Spotify Redirect URI (optional, default: http://localhost:8888/callback)
# This must match one of the redirect URIs in your Spotify app settings
SPOTIPY_REDIRECT_URI=http://localhost:8888/callback
